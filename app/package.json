{
  "name": "avaloka-v1-chat-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shadow": "node ../server/llm-shadow-server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "content:check": "node ../scripts/check-content-ingestion.mjs",
    "eval:v2": "node ../scripts/run-avaloka-v2-eval.mjs",
    "eval:memory": "node ../scripts/run-memory-response-eval.mjs",
    "eval:memory:claim-grounding": "node ../scripts/run-memory-claim-grounding.mjs",
    "eval:memory:reader": "node ../scripts/run-memory-reader-benchmark.mjs",
